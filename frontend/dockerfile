# Development Dockerfile for the frontend (uses Vite dev server)
FROM node:20
WORKDIR /app

# Install dependencies (cache package.json)
COPY package*.json ./
RUN npm install

# Copy source
COPY . .

# Expose Vite default port
EXPOSE 5173

# Run Vite dev server, binding to 0.0.0.0 so the container is reachable from the host
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]